{
  "schemaVersion": 1,
  "namespace": "it",
  "componentImports": [
    "^@/components/ui(/|$)",
    "^@cio/ui/base(/|$)",
    "^@cio/ui/imobiturbo(/|$)"
  ],
  "componentFiles": [
    "**/components/ui/**",
    "**/src/base/**",
    "**/src/imobiturbo/**"
  ],
  "note": "Imobiturbo: consulte @imobiturbo/design-system/reference e /catalog; não crie tokens locais para silenciar erros.",
  "forbiddenFonts": ["Futura", "Inter", "Barlow Condensed", "IBM Plex Mono"],
  "iconography": {
    "library": "lucide",
    "sizes": [16, 20, 24, 32],
    "strokeWidth": {
      "desktop": 1.75,
      "touch": 2
    }
  },
  "copy": {
    "locale": "pt-BR",
    "pronoun": "você",
    "emoji": false,
    "uppercase": "mono-only",
    "evidence": "Não inventar depoimentos, resultados, preços ou condições."
  },
  "contrastPairs": [
    ["accentFg", "accent"],
    ["textPrimary", "canvas"],
    ["textMuted", "canvas"],
    ["accentText", "canvas"],
    ["cardFg", "card"],
    ["destructiveFg", "destructive"],
    ["success", "successBg"],
    ["warning", "warningBg"],
    ["danger", "dangerBg"],
    ["info", "infoBg"],
    ["accentText", "accentSoft"],
    ["textMuted", "surface"],
    ["textMuted", "surfaceElevated"],
    ["textMuted", "surfaceHover"]
