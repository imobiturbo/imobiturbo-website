  "aliases": {
    "css": {
      "--it-green": "--it-accent",
      "--it-lime": "--it-accent",
      "--font-body": "--font-primary",
      "--radius-pill": "--radius-full"
    },
    "deprecations": ["colors_and_type.css", "dist/tailwind-preset.js"],
    "shadcnCss": {
      "background": "canvas",
      "foreground": "textPrimary",
      "card": "card",
      "card-foreground": "cardFg",
      "popover": "popover",
      "popover-foreground": "popoverFg",
      "primary": "primary",
      "primary-foreground": "primaryFg",
      "secondary": "secondary",
      "secondary-foreground": "secondaryFg",
      "muted": "muted",
      "muted-foreground": "mutedFg",
      "accent": "accentSoft",
      "accent-foreground": "accentText",
      "destructive": "destructive",
      "destructive-foreground": "destructiveFg",
      "border": "border",
      "input": "border",
      "ring": "ring"
    },
    "legacyCss": {
      "bg": "canvas",
      "text": "textPrimary",
      "error": "danger",
      "error-bg": "dangerBg",
      "accent-foreground": "accentFg"
